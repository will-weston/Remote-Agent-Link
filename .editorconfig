root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,xml,props,csproj,vcxproj,appxmanifest,config}]
indent_size = 2

[*.{sln,bat,cmd}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
