<UserControl
    x:Class="AgentLink.Broker.Views.AgentsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{StaticResource PageStackStyle}" Spacing="24">
            <TextBlock Text="Copilot and MCP setup" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap"
                       AutomationProperties.HeadingLevel="Level1" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="GitHub Copilot CLI" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind Model.Status, Mode=OneWay}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Model.Detail, Mode=OneWay}" Style="{StaticResource BodyText}" />
                    <Button Click="RegisterClicked" IsEnabled="{x:Bind Model.CanRegister, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}">
                        <TextBlock Text="Add to Copilot CLI" TextWrapping="Wrap" />
                    </Button>
                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind Model.Busy, Mode=OneWay}" AutomationProperties.Name="Adding MCP configuration" />
                    <Button Content="Refresh setup status" Click="RefreshClicked" />
                    <TextBlock Text="Then start a new Copilot CLI session and run:" Style="{StaticResource BodyText}" />
                    <TextBox Text="/mcp show remote-agent-link" IsReadOnly="True" AutomationProperties.Name="Check the MCP server in Copilot" />
                </StackPanel>
            </Border>
            <Expander Header="Manual setup and other agents" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="16">
                    <TextBlock Text="Each agent starts its own ralink-mcp.exe process using standard input/output. There is no HTTP address or listening MCP port. Home shows active agent connections separately from saved setup." Style="{StaticResource BodyText}" />
                    <TextBlock Text="Use rdp_list_connections and rdp_bind_connection to select a remote computer. The complete tool list is always available; actions use the selected computer and its device-access setting." Style="{StaticResource BodyText}" />
                    <TextBlock Text="Run this command from the Copilot profile you use:" Style="{StaticResource BodyText}" />
                    <TextBox Text="{x:Bind Model.Command}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Copilot MCP setup command" />
                    <Button Content="Copy setup command" Click="CopyCommandClicked" />
                    <TextBlock Text="Other MCP clients need their own stdio entry. Use ralink-mcp.exe as the command, with no arguments to discover remote devices. Use --current-session only to access this PC's broker." Style="{StaticResource BodyText}" />
                    <Button Content="Copy MCP JSON" Click="CopyJsonClicked" />
                    <TextBox Text="{x:Bind Model.ConfigurationPath}" Header="Copilot profile checked by this app" IsReadOnly="True" TextWrapping="Wrap" />
                    <TextBlock Text="A custom COPILOT_HOME, workspace configuration, disabled server, or organization policy can change what an agent loads. A saved entry is not proof that a particular running agent has connected." Style="{StaticResource BodyText}" />
                </StackPanel>
            </Expander>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Use a remote Copilot" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="Managed remote tasks need a compatible runtime and the remote user's Copilot sign-in. They run while device access is Yes and may consume that account's credits. Attaching to an existing interactive Copilot session isn't supported yet." Style="{StaticResource BodyText}" />
                    <Button Content="Runtime and advanced settings" Click="SettingsClicked" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
