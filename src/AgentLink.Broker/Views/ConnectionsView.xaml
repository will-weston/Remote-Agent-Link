<UserControl
    x:Class="AgentLink.Broker.Views.ConnectionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AgentLink.Broker.ViewModels">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{StaticResource PageStackStyle}" Spacing="16">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="This computer" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Model.DeviceName}" Style="{StaticResource SubtitleTextBlockStyle}"
                                   TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
                    </StackPanel>
                    <ToggleSwitch x:Name="DesktopAccessSwitch"
                                  IsOn="{x:Bind Model.DesktopAccessEnabled, Mode=OneWay}" Toggled="DesktopAccessToggled"
                                  OnContent="Yes" OffContent="No"
                                  AutomationProperties.Name="Allow agents to use this device">
                        <ToggleSwitch.Header>
                            <TextBlock Text="Allow agents to use this device" TextWrapping="Wrap" />
                        </ToggleSwitch.Header>
                    </ToggleSwitch>
                    <TextBlock Text="Uses your signed-in Windows/RDP session. No blocks agent desktop and coding actions and cancels broker work; RDP stays connected."
                               Style="{StaticResource BodyText}" />
                </StackPanel>
            </Border>
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind Model.AgentCount, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Text="Agents appear when their MCP connection is active, not just when configuration is saved."
                           Style="{StaticResource BodyText}" Visibility="{x:Bind Model.NoAgents, Mode=OneWay}" />
                <ItemsControl ItemsSource="{x:Bind Model.Agents}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AgentConnectionViewModel">
                            <Grid ColumnSpacing="10" Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE73E;" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Description}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <HyperlinkButton Click="AgentsClicked" Padding="0,4" HorizontalAlignment="Left">
                    <TextBlock Text="Copilot and MCP setup" TextWrapping="Wrap" />
                </HyperlinkButton>
            </StackPanel>
            <StackPanel Spacing="10">
                <TextBlock Text="Connected computers" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"
                           AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Text="Install and open Remote Agent Link on both computers, then connect with Windows App or Remote Desktop."
                           Style="{StaticResource BodyText}" Visibility="{x:Bind Model.IsEmpty, Mode=OneWay}" />
                <ItemsControl ItemsSource="{x:Bind Model.Peers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PeerViewModel">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind StatusGlyph}" FontSize="16" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind Status}" TextWrapping="Wrap" />
                                    <Expander Header="Details and MCP configuration" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{x:Bind Direction}" Style="{StaticResource BodyText}" />
                                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource BodyText}" />
                                            <TextBlock Text="{x:Bind ConnectedSince}" Style="{StaticResource BodyText}" />
                                            <TextBlock Text="{x:Bind McpDetails}" Style="{StaticResource BodyText}" />
                                            <Button Tag="{x:Bind}" Click="CopyMcpClicked" Visibility="{x:Bind CanCopyMcpConfiguration}">
                                                <TextBlock Text="{x:Bind McpActionLabel}" TextWrapping="Wrap" />
                                            </Button>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <Expander Header="Status and help" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Bind Model.Headline, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Model.Summary, Mode=OneWay}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="{x:Bind Model.DesktopStatus, Mode=OneWay}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="Closing this window keeps the broker in the notification area. Use its menu to block agent access or quit."
                               Style="{StaticResource BodyText}" />
                    <Button Click="SetupClicked"><TextBlock Text="Connection settings" TextWrapping="Wrap" /></Button>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
